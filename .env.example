APP_NAME=DentalClinic
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Supabase Postgres — the application's only database
#
# Route your connection through the SESSION pooler (port 5432):
#   DB_HOST     aws-0-<region>.pooler.supabase.com   (copy it from Connect,
#                                                     do not guess the region)
#   DB_USERNAME postgres.<project-ref>
#   DB_DATABASE postgres
#
# Why the session pooler:
#   * The direct connection (db.<ref>.supabase.co) is IPv6-only on the free
#     plan, so it fails from any IPv4-only network.
#   * The transaction pooler (port 6543) cannot do prepared statements, which
#     Eloquent uses, and it drops session state — so `search_path` would be lost.
#
# DB_PASSWORD is the DATABASE PASSWORD set when the project was created
# (Dashboard -> Connect -> Session pooler). It is NOT an API key: neither
# sb_publishable_* nor sb_secret_* will work here.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=

# Application schema, kept out of Supabase's published `public` schema.
DB_SCHEMA=dental

# Encrypt the connection; fail rather than fall back to plaintext.
DB_SSLMODE=require

# Match the Postgres session clock to the clinic's timezone.
DB_TIMEZONE=Asia/Manila

# ---------------------------------------------------------------------------
# Supabase values for the browser (frontend data layer)
#
# This is Laravel + Vite, NOT Next.js. Only variables prefixed VITE_ are
# exposed to the browser — NEXT_PUBLIC_* is silently ignored by Vite and the
# client would read `undefined`.
#
# VITE_SUPABASE_ANON_KEY takes the PUBLISHABLE key (sb_publishable_...),
# which is public by design and never trusted for authorization.
# Vite inlines these at build time: run `npm run build` after changing them.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
VITE_SUPABASE_SCHEMA=dental
# 'off' keeps every read on Laravel. 'on' requires database/supabase/01_schema.sql
# to have run AND the `dental` schema to be in the dashboard's Exposed schemas list.
VITE_SUPABASE_READS=off

# ---------------------------------------------------------------------------
# Supabase SECRET key (sb_secret_...) — SERVER-SIDE ONLY.
# .env is gitignored so this is not committed. Never prefix it with VITE_:
# anything VITE_* is baked into the public browser bundle.
#
# Laravel's database connection does not use this — that is DB_PASSWORD above.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# ---------------------------------------------------------------------------
# SMS Notification (mock eTextMo-compatible service)
# SMS_MOCK=true simulates the gateway and logs to sms_logs.
# Set SMS_MOCK=false + real credentials to hit the eTextMo API.
# ---------------------------------------------------------------------------
SMS_MOCK=true
SMS_API_KEY=your-etextmo-api-key
SMS_SENDER_ID=DentalClinic
SMS_ENDPOINT=https://api.etextmo.com/api/send-message

# ---------------------------------------------------------------------------
# Chat bot (Google Gemini)
# Get a free API key at https://aistudio.google.com/apikey
# Without a key the chat bot falls back to built-in offline answers.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=clinic@example.com
MAIL_FROM_NAME="${APP_NAME}"
