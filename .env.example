APP_NAME=DentalClinic
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# MySQL setup (uncomment and create the database):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dental_clinic
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# ---------------------------------------------------------------------------
# SMS Notification (mock eTextMo-compatible service)
# SMS_MOCK=true simulates the gateway and logs to sms_logs.
# Set SMS_MOCK=false + real credentials to hit the eTextMo API.
# ---------------------------------------------------------------------------
SMS_MOCK=true
SMS_API_KEY=your-etextmo-api-key
SMS_SENDER_ID=DentalClinic
SMS_ENDPOINT=https://api.etextmo.com/api/send-message

# ---------------------------------------------------------------------------
# Chat bot (Google Gemini)
# Get a free API key at https://aistudio.google.com/apikey
# Without a key the chat bot falls back to built-in offline answers.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=clinic@example.com
MAIL_FROM_NAME="${APP_NAME}"
